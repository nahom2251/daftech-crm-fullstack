{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=daftech_crm;Username=postgres;Password=CHANGE_ME;"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://daftech-crm-frontendd.onrender.com"
    ]
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "DaftechCrm",
    "Audience": "DaftechCrm.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "TicketWorkflow": {
    "MinimumSatisfactionScore": 90,
    "ClientConfirmationWindowDays": 5
  },
  "Email": {
    "Provider": "Smtp"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseStartTls": true,
    "Username": "CHANGE_ME",
    "Password": "CHANGE_ME",
    "FromAddress": "no-reply@daftech.et",
    "FromName": "DAFTECH CRM",
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 2
  },
  "BrevoApi": {
    "ApiKey": "CHANGE_ME",
    "ApiBaseUrl": "https://api.brevo.com/v3",
    "FromAddress": "no-reply@daftech.et",
    "FromName": "DAFTECH CRM",
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 2,
    "TimeoutSeconds": 15
  },
  "Storage": {
    "Provider": "LocalFileSystem",
    "RootPath": "storage/uploads",
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".png", ".jpg", ".jpeg", ".webm", ".ogg", ".m4a", ".mp3", ".wav" ],
    "MaxFileSizeBytes": 10485760
  },
  "Cloudinary": {
    "CloudName": "CHANGE_ME",
    "ApiKey": "CHANGE_ME",
    "ApiSecret": "CHANGE_ME",
    "Folder": "daftech-crm/ticket-attachments",
    "TimeoutSeconds": 20
  },
  "Session": {
    "OfflineAfterMinutes": 5
  },
  "AiReporting": {
    "Enabled": false,
    "ApiKey": "",
    "Model": "claude-sonnet-5",
    "ApiBaseUrl": "https://api.anthropic.com/v1/messages",
    "TimeoutSeconds": 20
  }
}