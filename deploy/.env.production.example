# Copy this file to .env (same folder as docker-compose.yml) and fill in
# real values. Never commit the real .env file — it belongs in .gitignore.

# --- PostgreSQL ---
POSTGRES_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# --- CORS ---
# The real deployed frontend origin, e.g. https://crm.daftech.et
# (Not needed if using this same docker-compose setup, where nginx proxies
# /api/ to the backend on the same origin — but set it anyway in case the
# API is ever reached directly or from another origin.)
FRONTEND_ORIGIN=https://crm.daftech.et

# --- SMTP ---
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@daftech.et

# --- AI Reporting (optional) ---
AI_REPORTING_ENABLED=false
AI_REPORTING_API_KEY=

# --- Networking ---
# Host port that nginx (the frontend container) binds to.
HTTP_PORT=80
